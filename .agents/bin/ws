#!/usr/bin/env bash
# ws — engineering workspace CLI
# One entry point for the project registry, runs, skill routing, and health checks.
#
# This tool carries no organisation's name. Who owns a given clone is declared in
# workspace.conf at the root; everything else here is the same for every company,
# team, and stack that uses this workspace.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CONF="$ROOT/workspace.conf"
SKILLS="$ROOT/.agents/skills"
TPL="$ROOT/.agents/templates"

# Organisation identity and the context location come from workspace.conf, so a
# fresh clone is re-branded by editing one file (or running `ws init`).
conf_get() {
  local key="$1" default="${2:-}"
  [ -f "$CONF" ] || { printf '%s' "$default"; return; }
  local v; v="$(sed -n "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*//p" "$CONF" | head -1)"
  v="${v%%#*}"; v="${v%"${v##*[![:space:]]}"}"
  [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$default"
}

ORG_NAME="$(conf_get org_name 'this organisation')"
ORG_KEY="$(conf_get org_key 'org')"
CONTEXT_DIR="$ROOT/$(conf_get context_dir 'context')"
REGISTRY="$CONTEXT_DIR/registry.tsv"
MEM="$CONTEXT_DIR/memory/projects"
RUNS="$CONTEXT_DIR/runs"
CONTEXT_SKILLS="$CONTEXT_DIR/skills"
CLIENTS_DIR="$CONTEXT_DIR/clients"
WORKS="$CONTEXT_DIR/works"
MANIFEST="$ROOT/.agents/skills.manifest"
LOCK="$ROOT/.agents/skills.lock"
SKILL_CACHE="$ROOT/.agents/.cache/skills"
SKILL_INDEX="$ROOT/.agents/.cache/source-index.json"

c_red()  { printf '\033[31m%s\033[0m\n' "$*"; }
c_grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
c_ylw()  { printf '\033[33m%s\033[0m\n' "$*"; }
c_dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
die()    { c_red "error: $*" >&2; exit 1; }

agent_id() {
  if   [ -n "${CLAUDECODE:-}" ];      then echo "claude"
  elif [ -n "${CURSOR_TRACE_ID:-}" ]; then echo "cursor"
  elif [ -n "${CODEX_SANDBOX:-}" ];   then echo "codex"
  else echo "${WS_AGENT:-dev}"; fi
}

# A run's owner is a person using a tool. "claude" alone is ambiguous the moment two
# developers both use Claude Code.
# Handle order: an explicit WS_USER wins, then the local part of the git email.
# Set WS_USER in your shell profile if the email gives an awkward handle.
human_id() {
  if [ -n "${WS_USER:-}" ]; then slug "$WS_USER"; return; fi
  local email; email="$(git config user.email 2>/dev/null || true)"
  if [ -n "$email" ]; then slug "${email%%@*}"; else echo "unknown"; fi
}
owner_id() { printf '%s-%s' "$(human_id)" "$(agent_id)"; }

slug() {
  printf '%s' "$*" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-48
}

# Read the registry (skip header and blank lines):
#   key<TAB>client<TAB>folder<TAB>remote<TAB>description
# Empty fields become "-" because `read` collapses consecutive tab delimiters,
# which would otherwise shift every column after a blank one.
reg_rows() {
  [ -f "$REGISTRY" ] || return 0
  tail -n +2 "$REGISTRY" | grep -v '^[[:space:]]*$' | awk -F'\t' 'BEGIN{OFS="\t"}
    { for (i = 1; i <= 5; i++) if ($i == "") $i = "-"; NF = 5; print }'
}
# "-" is the registry's empty marker
is_empty() { [ -z "${1:-}" ] || [ "${1:-}" = "-" ]; }
reg_get()  { reg_rows | awk -F'\t' -v k="$1" '$1==k {print; exit}'; }

# Skills live in the workspace (shared by every organisation), the organisation's
# own context (its cross-client domain skills, if any), and each client's own
# folder (that client's domain, shared by every one of their projects). All three
# are searched.
skill_dirs() {
  local d
  for d in "$SKILLS"/*/; do [ -d "$d" ] && printf '%s\n' "$d"; done
  [ -d "$CONTEXT_SKILLS" ] && for d in "$CONTEXT_SKILLS"/*/; do [ -d "$d" ] && printf '%s\n' "$d"; done
  [ -d "$CLIENTS_DIR" ] || return 0
  for d in "$CLIENTS_DIR"/*/skills/*/; do [ -d "$d" ] && printf '%s\n' "$d"; done
}

# ─────────────────────────────────────────────────────────────── init
# Re-brands a fresh clone for a new organisation and empties the previous owner's
# context. This is what makes the workspace reusable rather than one company's repo.
cmd_init() {
  local name="" key="" group="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --org)   name="${2:-}"; shift 2 ;;
      --key)   key="${2:-}"; shift 2 ;;
      --group) group="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      *) die "usage: ws init [--org \"Name\"] [--key abc] [--group git@host:group] [--force]" ;;
    esac
  done

  if [ -f "$CONF" ] && [ "$force" = 0 ]; then
    c_ylw "workspace.conf already exists - this clone belongs to: $ORG_NAME"
    c_dim "  edit it by hand, or re-run with --force to overwrite"
    return 0
  fi

  [ -n "$name" ]  || { printf 'Organisation name: '; read -r name; }
  [ -n "$key" ]   || { printf 'Short key (lowercase, e.g. acme): '; read -r key; }
  [ -n "$group" ] || { printf 'Git group (e.g. git@gitlab.com:acme): '; read -r group; }
  key="$(slug "$key")"

  cat > "$CONF" <<CONF
# Who owns this clone of the workspace. See .agents/standards/README.md for packs.
org_name  = $name
org_key   = $key
git_group = $group

context_dir    = context
context_remote =

packs = core, java
CONF
  c_grn "-> workspace.conf written for $name"
  c_dim "   next: ws context init   (or: ws context clone <remote>)"
}

# ─────────────────────────────────────────────────────────────── context
# The organisation's private memory, runs, registry, client ADRs, and domain
# skills. A separate repository, mounted at context/ and ignored here.
cmd_context() {
  local action="${1:-status}"; shift || true
  case "$action" in
    init)
      [ -d "$CONTEXT_DIR/.git" ] && die "context already exists at ${CONTEXT_DIR#$ROOT/}"
      mkdir -p "$CONTEXT_DIR"/{memory/projects,runs,docs/adr,skills,clients}
      printf 'key\tclient\tfolder\tremote\tdescription\n' > "$CONTEXT_DIR/registry.tsv"
      [ -f "$TPL/context-readme.md" ] \
        && sed "s|{{ORG}}|$ORG_NAME|g" "$TPL/context-readme.md" > "$CONTEXT_DIR/README.md"
      [ -f "$TPL/context-gitattributes" ] && cp "$TPL/context-gitattributes" "$CONTEXT_DIR/.gitattributes"
      touch "$CONTEXT_DIR/runs/.gitkeep"
      git -C "$CONTEXT_DIR" init -q -b main
      c_grn "-> context repository created at ${CONTEXT_DIR#$ROOT/}"
      c_dim "   give it a remote, then record it as context_remote in workspace.conf"
      ;;
    clone)
      local remote="${1:-}"; [ -n "$remote" ] || die "usage: ws context clone <remote>"
      [ -d "$CONTEXT_DIR/.git" ] && die "context already exists at ${CONTEXT_DIR#$ROOT/}"
      git clone "$remote" "$CONTEXT_DIR"
      c_grn "-> context cloned"
      ;;
    status)
      if [ -d "$CONTEXT_DIR/.git" ]; then
        c_grn "context: ${CONTEXT_DIR#$ROOT/} ($(git -C "$CONTEXT_DIR" remote get-url origin 2>/dev/null || echo 'no remote'))"
        local n; n="$(count_dirs "$MEM")"
        c_dim "  $n project(s) in memory"
      else
        c_ylw "no context yet - run: ws context init"
      fi
      ;;
    *) die "usage: ws context [status|init|clone <remote>]" ;;
  esac
}

# A repository is public if it can be read without credentials. That is testable
# without any host's API: strip the credential helpers and try. A network failure
# looks the same as "private", so this can miss a problem but never invents one.
repo_is_public() {
  local url; url="$(printf '%s' "$1" | sed -E 's#^git@([^:]+):#https://\1/#; s#^ssh://git@([^/]+)/#https://\1/#')"
  case "$url" in https://*) ;; *) return 1 ;; esac
  GIT_TERMINAL_PROMPT=0 git -c credential.helper= -c core.askPass=true \
    -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=8 \
    ls-remote "$url" >/dev/null 2>&1
}

# Counting files in a directory that may not exist yet is the single most common
# way this script has broken: `find` returns 1, pipefail promotes that to the whole
# pipeline, and `set -e` kills the run inside a command substitution. Every count
# goes through here so that cannot happen again.
count_files() {
  local dir="$1"; shift
  [ -d "$dir" ] || { printf '0'; return 0; }
  local n; n="$(find "$dir" "$@" 2>/dev/null | wc -l | tr -d ' ')" || n=0
  printf '%s' "${n:-0}"
}

count_dirs() {
  local dir="$1"
  [ -d "$dir" ] || { printf '0'; return 0; }
  local n; n="$(find "$dir" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')" || n=0
  printf '%s' "${n:-0}"
}

# ─────────────────────────────────────────────────────────────── list
cmd_list() {
  printf '%-20s %-12s %-40s %-8s %s\n' KEY CLIENT FOLDER STATUS REMOTE
  while IFS=$'\t' read -r key client folder remote desc; do
    local status="missing"
    [ -d "$ROOT/$folder/.git" ] && status="ok"
    [ -d "$ROOT/$folder" ] && [ ! -d "$ROOT/$folder/.git" ] && status="no-git"
    printf '%-20s %-12s %-40s %-8s %s\n' "$key" "$client" "$folder" "$status" "$remote"
  done < <(reg_rows)
}

# ─────────────────────────────────────────────────────────────── bootstrap
cmd_bootstrap() {
  local n=0

  # Skills first: they are what an agent reads before touching any of the code we
  # are about to clone. Unreachable source is a warning, not a failure - a new
  # machine on a bad network should still end up with its repositories, and
  # `ws doctor` reports the missing skills until someone syncs them.
  if [ -f "$MANIFEST" ]; then
    c_grn "→ skills"
    skills_sync || c_ylw "! could not reach the skills source - run: ws skills sync"
  fi

  if [ -n "$(conf_get context_remote)" ] && [ ! -d "$CONTEXT_DIR/.git" ]; then
    c_grn "→ context"
    cmd_context clone "$(conf_get context_remote)" || c_ylw "! could not clone the context repo"
  fi

  while IFS=$'\t' read -r key client folder remote desc; do
    local dst="$ROOT/$folder"
    if [ -d "$dst/.git" ]; then c_dim "- $key already present"; continue; fi
    if is_empty "$remote"; then
      c_ylw "! $key has no remote in registry.tsv - skipping"
      c_dim "  set one with: ws new $key $folder <remote-url>"
      continue
    fi
    c_grn "→ clone $key"
    git clone "$remote" "$dst"
    cmd_link "$key"
    n=$((n+1))
  done < <(reg_rows)
  c_grn "bootstrap complete ($n cloned)"
}

# ─────────────────────────────────────────────────────────────── client
# A client may have several projects (registry.tsv's `client` column links them).
# clients/<key>/ holds what is true regardless of which of their projects it is:
# the domain glossary, cross-project decisions, their proposals and ADRs. It is
# NOT a container for project keys - those stay flat in memory/ and runs/, so a
# project can change client without moving four directory trees.
cmd_client() {
  case "${1:-list}" in
    new)  shift; client_new "$@" ;;
    list) client_list ;;
    *) die "usage: ws client [new <key> | list]" ;;
  esac
}

client_new() {
  local key="${1:-}"; [ -n "$key" ] || die "usage: ws client new <key>"
  key="$(slug "$key")"
  [ -d "$CONTEXT_DIR/.git" ] || die "no context repo yet - run: ws context init"
  local dst="$CLIENTS_DIR/$key"
  [ -d "$dst" ] && die "client '$key' already exists at ${dst#$ROOT/}"

  mkdir -p "$dst/docs/adr" "$dst/skills"
  local date_now; date_now="$(date +%F)"
  if [ -f "$TPL/client.md" ]; then
    sed "s|{{CLIENT}}|$key|g; s|{{DATE}}|$date_now|g" "$TPL/client.md" > "$dst/client.md"
  else
    printf '# %s\n\n(empty)\n' "$key" > "$dst/client.md"
  fi
  if [ -f "$TPL/client-decisions.md" ]; then
    sed "s|{{CLIENT}}|$key|g" "$TPL/client-decisions.md" > "$dst/decisions.md"
  else
    printf '# %s - decisions\n' "$key" > "$dst/decisions.md"
  fi
  c_grn "-> client '$key' created at ${dst#$ROOT/}"
  c_dim "   register a project against it with: ws new <key> <folder> --client $key"
}

client_list() {
  [ -d "$CLIENTS_DIR" ] || { c_dim "no clients yet - ws client new <key>"; return 0; }
  printf '%-16s %s\n' CLIENT PROJECTS
  local c
  for c in "$CLIENTS_DIR"/*/; do
    [ -d "$c" ] || continue
    c="$(basename "$c")"
    local projects; projects="$(reg_rows | awk -F'\t' -v c="$c" '$2==c {print $1}' | tr '\n' ' ')"
    printf '%-16s %s\n' "$c" "${projects:--}"
  done
}

# ─────────────────────────────────────────────────────────────── new
cmd_new() {
  local key="" folder="" remote="" client="-"
  local pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --client) client="${2:?}"; shift 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  set -- "${pos[@]}"
  key="${1:-}"; folder="${2:-}"; remote="${3:-}"
  [ -n "$key" ] && [ -n "$folder" ] \
    || die "usage: ws new <key> <folder> [remote-url] [--client <client-key>]"
  [ -n "$(reg_get "$key")" ] && die "key '$key' is already registered"

  if [ "$client" != "-" ] && [ ! -d "$CLIENTS_DIR/$client" ]; then
    c_ylw "! no client '$client' at context/clients/$client/ - create it first: ws client new $client"
    die "aborted: unknown client"
  fi

  local dst="$ROOT/$folder"
  if [ -n "$remote" ] && [ ! -d "$dst" ]; then
    git clone "$remote" "$dst"
  elif [ ! -d "$dst/.git" ]; then
    mkdir -p "$dst" && git -C "$dst" init -q -b main
    [ -n "$remote" ] && git -C "$dst" remote add origin "$remote"
    c_grn "-> new repo at $folder"
  fi

  printf '%s\t%s\t%s\t%s\t%s\n' "$key" "$client" "$folder" "${remote:--}" "new project" >> "$REGISTRY"
  c_grn "-> registered in registry.tsv"
  [ "$client" = "-" ] && c_ylw "  ! no --client given - ws hours --client and the domain skill lookup won't find this project"

  mkdir -p "$MEM/$key"
  for f in project active decisions log; do
    [ -f "$MEM/$key/$f.md" ] && continue
    if [ -f "$TPL/memory-$f.md" ]; then
      sed "s|{{KEY}}|$key|g; s|{{FOLDER}}|$folder|g; s|{{DATE}}|$(date +%F)|g" \
        "$TPL/memory-$f.md" > "$MEM/$key/$f.md"
    else
      printf '# %s - %s\n\n(empty)\n' "$key" "$f" > "$MEM/$key/$f.md"
    fi
  done
  c_grn "-> memory created at ${MEM#$ROOT/}/$key/"
  cmd_link "$key"
}

# ─────────────────────────────────────────────────────────────── where
# Print the workspace root. Works from inside a product repo by walking up to a
# .workspace breadcrumb, so it answers even when this script is not on PATH.
cmd_where() {
  local d

  # A workspace root is recognisable by what it contains, so a moved, renamed, or
  # freshly cloned workspace resolves without regenerating anything. A product repo
  # carries a pointer AGENTS.md but no .agents/standards, so it is never mistaken
  # for the root.
  d="$PWD"
  while [ "$d" != "/" ]; do
    if [ -f "$d/AGENTS.md" ] && [ -d "$d/.agents/standards" ]; then
      printf '%s\n' "$d"; return 0
    fi
    d="$(dirname "$d")"
  done

  # Fallback: a product repo cloned outside the workspace still has the breadcrumb.
  d="$PWD"
  while [ "$d" != "/" ]; do
    if [ -f "$d/.workspace" ]; then
      local marked; marked="$(sed -n 's/^workspace=//p' "$d/.workspace" | head -1)"
      if [ -n "$marked" ] && [ -d "$marked/.agents/standards" ]; then
        printf '%s\n' "$marked"; return 0
      fi
    fi
    d="$(dirname "$d")"
  done

  printf '%s\n' "$ROOT"
}

# ─────────────────────────────────────────────────────────────── link
# Write an UNTRACKED pointer AGENTS.md into the product repo and register it in
# .git/info/exclude so it never enters a client commit.
cmd_link() {
  local key="${1:-}"; [ -n "$key" ] || die "usage: ws link <key>"
  local row; row="$(reg_get "$key")" || true
  [ -n "$row" ] || die "key '$key' is not in registry.tsv"
  local folder; folder="$(printf '%s' "$row" | cut -f3)"
  local dst="$ROOT/$folder"
  [ -d "$dst/.git" ] || die "$folder is not a git repo - run ws bootstrap first"

  cat > "$dst/AGENTS.md" <<PTR
<!-- GENERATED BY: ws link $key - UNTRACKED, do not commit to this repo. -->

# AGENTS.md - pointer

This is a **product repo**. Engineering standards, agent skills, and team memory are NOT
stored here; they all live in the $ORG_NAME engineering workspace.

**Read first:** \`$ROOT/AGENTS.md\`

| You need | Open |
|---|---|
| Agent contract | \`$ROOT/AGENTS.md\` |
| Engineering standards | \`$ROOT/.agents/standards/\` |
| Skills | \`$ROOT/.agents/skills/\` and \`$ROOT/context/skills/\` |
| Memory for this project | \`$ROOT/.agents/memory/projects/$key/\` |
| Active runs | \`$ROOT/.agents/runs/$key/\` |

**Recommended:** close this folder and open your editor at \`$ROOT\` instead. Standards and
skills then load automatically while this repo stays isolated in git terms.

Regenerate with: \`ws link $key\`
PTR

  # Exclude each pointer independently. A single combined guard would skip
  # /.workspace in any clone linked before that file existed, leaving it visible
  # to `git add .` in a client repo.
  local exc="$dst/.git/info/exclude"
  mkdir -p "$(dirname "$exc")"; touch "$exc"
  grep -qxF '# ws link - workspace pointer, local only' "$exc" \
    || printf '\n# ws link - workspace pointer, local only\n' >> "$exc"
  local pat
  for pat in '/AGENTS.md' '/.workspace'; do
    grep -qxF "$pat" "$exc" || printf '%s\n' "$pat" >> "$exc"
  done
  # Machine-readable breadcrumb: lets a tool or agent find the workspace WITHOUT
  # having `ws` on PATH. Local to this machine, like the pointer above.
  cat > "$dst/.workspace" <<MARK
# Generated by: ws link $key
# Local to this machine and NOT committed. Regenerate with: ws link $key
workspace=$ROOT
project_key=$key
generated=$(date +%F)
MARK
  install_guard_hook "$dst"
  c_grn "-> $folder/AGENTS.md written (untracked, excluded)"
}

# .git/info/exclude keeps the pointers out of `git status`. The hook is the second
# line of defence: it refuses the commit even if someone stages them with `git add -f`.
install_guard_hook() {
  local dst="$1" hook="$1/.git/hooks/pre-commit"

  # An older version of this tool wrote the same guard under a different marker.
  # Recognise it so an upgrade replaces it instead of refusing to touch it.
  if [ -f "$hook" ] && ! grep -qE 'mkt-guard|ws-guard' "$hook"; then
    c_ylw "  ! $dst/.git/hooks/pre-commit exists and is not ours - guard not installed"
    c_dim "    add this check by hand: reject AGENTS.md and .workspace when staged"
    return 0
  fi

  cat > "$hook" <<'HOOK'
#!/bin/sh
# ws-guard: workspace pointers must never enter a client repo
# Installed by `ws link`. Remove the file to disable.
staged="$(git diff --cached --name-only | grep -E '^(AGENTS\.md|\.workspace)$' || true)"
if [ -n "$staged" ]; then
  echo "ws-guard: refusing to commit workspace pointers into this repo:" >&2
  echo "$staged" | sed 's/^/  /' >&2
  echo "" >&2
  echo "These files are generated by 'ws link' and are local to your machine." >&2
  echo "Unstage them:  git rm --cached AGENTS.md .workspace" >&2
  exit 1
fi
HOOK
  chmod +x "$hook"
}

cmd_unlink() {
  local key="${1:-}"; [ -n "$key" ] || die "usage: ws unlink <key>"
  local folder; folder="$(reg_get "$key" | cut -f3)"
  rm -f "$ROOT/$folder/AGENTS.md" "$ROOT/$folder/.workspace"
  local hook="$ROOT/$folder/.git/hooks/pre-commit"
  [ -f "$hook" ] && grep -q 'ws-guard' "$hook" && rm -f "$hook"
  c_grn "-> pointer removed from $folder"
}

# ─────────────────────────────────────────────────────────────── run
cmd_run() {
  local key="${1:-}"; shift || true
  local title="${*:-}"
  [ -n "$key" ] && [ -n "$title" ] || die 'usage: ws run <project-key> "task title"'
  [ -d "$MEM/$key" ] || die "project '$key' has no memory yet - run ws new first"

  local dir="$RUNS/$key/$(date +%Y-%m-%d-%H%M%S)-$(owner_id)-$(slug "$title")"
  [ -d "$dir" ] && die "run already exists: $dir"
  mkdir -p "$dir/contributors"

  local date_now; date_now="$(date '+%F %H:%M %z')"
  for f in brief plan progress decisions evidence handoff; do
    if [ -f "$TPL/run-$f.md" ]; then
      sed "s|{{KEY}}|$key|g; s|{{TITLE}}|$title|g; s|{{DATE}}|$date_now|g; s|{{OWNER}}|$(human_id) ($(agent_id))|g" \
        "$TPL/run-$f.md" > "$dir/$f.md"
    else
      printf '# %s - %s\n\nRun: %s\nDate: %s\n' "$title" "$f" "$key" "$date_now" > "$dir/$f.md"
    fi
  done

  c_grn "-> run created"
  printf '%s\n' "${dir#$ROOT/}"
  c_dim "  owner: $(human_id) ($(agent_id)) - start with brief.md, then plan.md"
}

# ─────────────────────────────────────────────────────────────── log
# Appends one row to a project's shared log. Hand-editing that file is what makes
# two people conflict on it; appending through one code path plus the union merge
# driver in .gitattributes means concurrent entries both survive.
cmd_log() {
  local key="${1:-}"; shift || true
  local text="${*:-}"
  [ -n "$key" ] && [ -n "$text" ] || die 'usage: ws log <project-key> "milestone"'
  local f="$MEM/$key/log.md"
  [ -f "$f" ] || die "no log at .agents/memory/projects/$key/log.md"
  case "$text" in *'|'*) die "a milestone cannot contain '|' - it breaks the table";; esac
  printf '| %s | %s (%s) |\n' "$(date +%F)" "$text" "$(human_id)" >> "$f"
  c_grn "-> appended to .agents/memory/projects/$key/log.md"
}

# ─────────────────────────────────────────────────────────────── sync
# Pulling before editing shared memory is the single biggest conflict reducer.
# Product repos are only reported on, never touched: rebasing someone else's
# work-in-progress is not this command's business.
cmd_sync() {
  [ -n "$(git -C "$ROOT" remote 2>/dev/null)" ] || die "workspace has no remote yet"
  c_grn "-> syncing workspace"
  git -C "$ROOT" pull --rebase --autostash

  echo
  echo "-- Product repos (not touched) --"
  local key client folder remote desc
  while IFS=$'\t' read -r key client folder remote desc; do
    local dst="$ROOT/$folder"
    [ -d "$dst/.git" ] || { c_dim "- $key not cloned"; continue; }
    local dirty=""; [ -n "$(git -C "$dst" status --porcelain)" ] && dirty=" (uncommitted changes)"
    local br; br="$(git -C "$dst" branch --show-current 2>/dev/null || echo '?')"
    c_dim "- $key on $br$dirty"
  done < <(reg_rows)
}

# ─────────────────────────────────────────────────────────────── route
# Normalise for matching: lowercase, -ize/-isation -> -ise/-isation, drop trailing plural.
# Without this, "authorization" in a query never matches "authorisation" in a skill.
norm() {
  tr '[:upper:]' '[:lower:]' \
    | sed -E 's/iz(e|ing|ation|ed)/is\1/g; s/([a-z]{5,})s\b/\1/g'
}

cmd_route() {
  local q; q="$(printf '%s' "${*:-}" | norm)"
  [ -n "$q" ] || die 'usage: ws route "task description"'

  local tmp; tmp="$(mktemp)"
  export -f norm 2>/dev/null || true
  for d in $(skill_dirs); do
    [ -f "$d/SKILL.md" ] || continue
    local name; name="$(basename "$d")"
    # Score = 5 x curated keyword hits + 1 x description word hits.
    # Curated keywords carry the weight; prose matching only breaks ties.
    local kw desc score
    # `grep -v` (and `sort -u`, on some builds) exits 1 on empty input - a skill
    # with no `keywords:` line, say - and under pipefail that propagates as the
    # exit status of the kw=/desc= assignment. Under errexit that silently kills
    # the whole script on the first such skill, which used to be every query.
    # `|| true` on the terminal read of each pipeline absorbs it: the assignment
    # still captures whatever text made it through.
    kw="$(
      { sed -n 's/^keywords:[[:space:]]*//p' "$d/SKILL.md" | norm | tr ',' '\n' \
          | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | grep -v '^$' \
          | while read -r w; do
              if [ "${q#*$w}" != "$q" ]; then echo 1; fi
            done
      } | wc -l | tr -d ' ' || true
    )"
    desc="$(
      { sed -n '/^description:/,/^[a-z]*:/p' "$d/SKILL.md" 2>/dev/null \
          | norm | tr -cs 'a-z0-9' '\n' \
          | awk 'length($0) > 5' | sort -u \
          | while read -r w; do
              if [ "${q#*$w}" != "$q" ]; then echo 1; fi
            done
      } | wc -l | tr -d ' ' || true
    )"
    score=$(( kw * 5 + desc ))
    if [ "${score:-0}" -ge 5 ]; then
      printf '%3s\t%s\t%s\n' "$score" "$name" "${d#$ROOT/}SKILL.md"
    fi
  done | sort -rn | head -3 > "$tmp"

  if [ -s "$tmp" ]; then
    printf '%-5s %-24s %s\n' SCORE SKILL PATH
    awk -F'\t' '{ printf "%-5s %-24s %s\n", $1, $2, $3 }' "$tmp"
  else
    c_ylw "no clear skill match - see .agents/skills/README.md"
  fi
  rm -f "$tmp"
}

# ─────────────────────────────────────────────────────────────── skills
# Indexes ONE skill directory. The framework index must never contain an
# organisation's domain skills: .agents/skills/index.json is tracked in the shared
# repository, while context skills belong to whoever owns the context repo.
build_skills_index() {
  local out="$1" dir="$2" first=1
  { echo '{'; echo '  "generated": "'"$(date -u +%FT%TZ)"'",'; echo '  "skills": ['; } > "$out"
  for d in "$dir"/*/; do
    [ -f "$d/SKILL.md" ] || continue
    local name desc
    name="$(basename "$d")"
    desc="$(awk '
        NR==1 && $0=="---" { inFm=1; next }
        inFm && $0=="---"  { exit }
        !inFm              { exit }
        /^description:/    { f=1; sub(/^description:[ ]*>?-?[ ]*/,""); if (length($0)) print; next }
        f && /^[A-Za-z_][A-Za-z0-9_]*:/ { exit }
        f                  { sub(/^[ \t]+/,""); print }
      ' "$d/SKILL.md" \
      | tr '\n' ' ' | sed 's/  */ /g; s/[[:space:]]*$//; s/"/\\"/g')"
    local kw pack path
    kw="$(sed -n 's/^keywords:[[:space:]]*//p' "$d/SKILL.md" | head -1 | sed 's/"/\\"/g')"
    pack="$(sed -n 's/^pack:[[:space:]]*//p' "$d/SKILL.md" | head -1)"
    path="${d#$ROOT/}SKILL.md"
    [ "$first" = 1 ] || echo ',' >> "$out"; first=0
    printf '    {"name": "%s", "pack": "%s", "path": "%s", "keywords": "%s", "description": "%s"}' \
      "$name" "${pack:-java}" "$path" "$kw" "$desc" >> "$out"
  done
  { echo; echo '  ]'; echo '}'; } >> "$out"
}

cmd_skills() {
  local action="${1:-status}"; shift || true
  case "$action" in
    status)    skills_status ;;
    sync)      skills_sync ;;
    add)       skills_edit add "$@" ;;
    remove|rm) skills_edit remove "$@" ;;
    available) skills_available ;;
    index)     skills_index ;;
    *) die "usage: ws skills [status|sync|add <name>|remove <name>|available|index]" ;;
  esac
}

skills_index() {
  build_skills_index "$SKILLS/index.json" "$SKILLS"
  c_grn "-> .agents/skills/index.json ($(grep -c '"name"' "$SKILLS/index.json") skills)"
  if [ "$(count_files "$CONTEXT_SKILLS" -maxdepth 2 -name SKILL.md)" != 0 ]; then
    build_skills_index "$CONTEXT_SKILLS/index.json" "$CONTEXT_SKILLS"
    c_grn "-> context/skills/index.json ($(grep -c '"name"' "$CONTEXT_SKILLS/index.json") skills)"
  fi
}

skills_status() {
  local want; want="$(manifest_resolve 2>/dev/null | wc -l | tr -d ' ')"
  local have; have="$(count_files "$SKILLS" -maxdepth 2 -name SKILL.md)"
  c_grn "source: $(conf_manifest source '(none)')  ref: $(conf_manifest ref main)"
  [ -f "$LOCK" ] && c_dim "  pinned: $(sed -n 's/^commit[[:space:]]*=[[:space:]]*//p' "$LOCK" | head -1)"
  printf '  %s wanted, %s materialised in .agents/skills/\n' "$want" "$have"
  [ "$want" = "$have" ] || c_ylw "  ! out of sync - run: ws skills sync"
  local n=0
  n="$(count_files "$CONTEXT_SKILLS" -maxdepth 2 -name SKILL.md)"
  [ "$n" != 0 ] && c_dim "  plus $n domain skill(s) in context/skills/"
  return 0
}

# Read a key from the manifest's header (source =, ref =).
conf_manifest() {
  local key="$1" default="${2:-}"
  [ -f "$MANIFEST" ] || { printf '%s' "$default"; return; }
  local v; v="$(sed -n "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*//p" "$MANIFEST" | head -1)"
  v="${v%%#*}"; v="${v%"${v##*[![:space:]]}"}"
  [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$default"
}

# The cache is a blobless, checkout-less clone. Only the paths we ask for are
# ever materialised, which is what makes "take three skills out of forty" cheap.
skills_cache() {
  local src; src="$(conf_manifest source)"
  [ -n "$src" ] || die "no 'source =' in .agents/skills.manifest"
  local ref; ref="$(conf_manifest ref main)"
  if [ ! -d "$SKILL_CACHE/.git" ]; then
    mkdir -p "$(dirname "$SKILL_CACHE")"
    git clone --quiet --filter=blob:none --no-checkout "$src" "$SKILL_CACHE"
    git -C "$SKILL_CACHE" sparse-checkout init --cone --quiet 2>/dev/null || true
  fi
  git -C "$SKILL_CACHE" remote set-url origin "$src"
  git -C "$SKILL_CACHE" fetch --quiet origin "$ref"
  # Cone-mode sparse checkout only understands directories, and the index is a
  # file at the root - so read it straight out of the object store instead.
  git -C "$SKILL_CACHE" show FETCH_HEAD:index.json > "$SKILL_INDEX" 2>/dev/null \
    || die "the source repository has no index.json at its root"
}

# Expand the manifest's `pack X` / `skill Y` lines into a plain list of names.
# The remote's index.json is the authority on which skills a pack contains.
manifest_resolve() {
  [ -f "$MANIFEST" ] || return 0
  local idx="$SKILL_INDEX"
  local kind name
  while read -r kind name; do
    case "$kind" in
      pack)
        [ -f "$idx" ] || { c_ylw "  ! no cached index - run: ws skills sync" >&2; return 0; }
        sed -n 's/.*"name": "\([^"]*\)", "pack": "\([^"]*\)".*/\2 \1/p' "$idx" \
          | awk -v p="$name" '$1==p {print $2}'
        ;;
      skill) printf '%s\n' "$name" ;;
    esac
  done < <(grep -E '^[[:space:]]*(pack|skill)[[:space:]]+[A-Za-z0-9_-]+' "$MANIFEST" \
             | sed -E 's/^[[:space:]]*//; s/[[:space:]]+/ /g; s/[[:space:]]*#.*//')
  return 0
}

skills_available() {
  skills_cache
  local idx="$SKILL_INDEX"
  printf '%-32s %-7s %s\n' SKILL PACK WANTED
  local wanted; wanted="$(manifest_resolve | sort -u)"
  sed -n 's/.*"name": "\([^"]*\)", "pack": "\([^"]*\)".*/\1 \2/p' "$idx" | sort | \
  while read -r name pack; do
    local mark="-"
    printf '%s\n' "$wanted" | grep -qxF "$name" && mark="yes"
    printf '%-32s %-7s %s\n' "$name" "$pack" "$mark"
  done
}

skills_edit() {
  local op="$1"; shift
  [ $# -gt 0 ] || die "usage: ws skills $op <name> [name...]"
  [ -f "$MANIFEST" ] || die "no .agents/skills.manifest"
  local n
  for n in "$@"; do
    case "$op" in
      add)
        grep -qE "^[[:space:]]*skill[[:space:]]+$n[[:space:]]*$" "$MANIFEST" \
          && { c_dim "- $n already in the manifest"; continue; }
        printf 'skill %s\n' "$n" >> "$MANIFEST"; c_grn "+ $n" ;;
      remove)
        if grep -qE "^[[:space:]]*skill[[:space:]]+$n[[:space:]]*$" "$MANIFEST"; then
          grep -vE "^[[:space:]]*skill[[:space:]]+$n[[:space:]]*$" "$MANIFEST" > "$MANIFEST.tmp"
          mv "$MANIFEST.tmp" "$MANIFEST"; c_grn "- $n"
        else
          c_ylw "! $n is not listed individually (it may come from a pack)"
        fi ;;
    esac
  done
  skills_sync
}

# Materialises exactly the wanted skills, then records the commit they came from.
# .agents/skills/ is generated and git-ignored: the manifest and the lock are the
# tracked truth, so a teammate gets byte-identical skills from `ws skills sync`.
skills_sync() {
  skills_cache
  local sha; sha="$(git -C "$SKILL_CACHE" rev-parse FETCH_HEAD)"

  local wanted; wanted="$(manifest_resolve | sort -u)"
  [ -n "$wanted" ] || { c_ylw "manifest lists no skills"; return 0; }

  local paths=()
  local n
  while IFS= read -r n; do [ -n "$n" ] && paths+=("skills/$n"); done <<< "$wanted"
  git -C "$SKILL_CACHE" sparse-checkout set "${paths[@]}" >/dev/null
  git -C "$SKILL_CACHE" checkout --quiet -B sync FETCH_HEAD

  mkdir -p "$SKILLS"
  # Remove previously materialised skills that are no longer wanted, leaving any
  # hand-written local skill (one the manifest never mentions but that has no
  # counterpart upstream) untouched is NOT safe here - so we only delete what we
  # know we placed, tracked in the lock's file list.
  if [ -f "$LOCK" ]; then
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      printf '%s\n' "$wanted" | grep -qxF "$n" || { rm -rf "${SKILLS:?}/$n"; c_dim "- $n removed"; }
    done < <(sed -n 's/^skill[[:space:]]*=[[:space:]]*//p' "$LOCK")
  fi

  local added=0
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if [ ! -d "$SKILL_CACHE/skills/$n" ]; then
      c_red "x '$n' is not in the source repository"; continue
    fi
    rm -rf "${SKILLS:?}/$n"
    cp -R "$SKILL_CACHE/skills/$n" "$SKILLS/$n"
    added=$((added+1))
  done <<< "$wanted"

  { printf '# Generated by `ws skills sync`. Tracked: it pins what everyone gets.\n'
    printf 'source = %s\n' "$(conf_manifest source)"
    printf 'ref    = %s\n' "$(conf_manifest ref main)"
    printf 'commit = %s\n' "$sha"
    printf 'synced = %s\n' "$(date -u +%FT%TZ)"
    printf '%s\n' "$wanted" | sed 's/^/skill = /'
  } > "$LOCK"

  build_skills_index "$SKILLS/index.json" "$SKILLS"
  c_grn "-> $added skills materialised from ${sha:0:8}"
}

# ─────────────────────────────────────────────────────────────── clock / agent
# Two clocks, never one.
#
# Human hours are payroll and invoice hours: a person's attention, which cannot
# run in parallel with itself. Agent hours are machine time: cheap, often several
# at once, and billed in tokens rather than salary. Adding them produces a number
# that is wrong for every purpose - it overstates effort to a client, understates
# cost to finance, and tells a lead nothing about capacity. So they are recorded
# in separate files and reported in separate columns, and `ws hours` will not
# print a combined total.

now_iso()  { date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/'; }
now_ts()   { date +%s; }
works_file() { printf '%s/%s/%s/%s.jsonl' "$WORKS" "$1" "$2" "$(date +%Y-%m)"; }
open_file()  { printf '%s/.open-%s-%s.json' "$WORKS" "$1" "$(human_id)"; }

# kind = human | agent
clock_in() {
  local kind="$1" key="${2:-}"; shift 2 || true
  local note="${*:-}"
  [ -n "$key" ] || die "usage: ws ${kind/human/clock} in <project-key> [note]"
  [ -d "$MEM/$key" ] || c_ylw "! '$key' has no memory yet - is the key right?"
  mkdir -p "$WORKS"
  local of; of="$(open_file "$kind")"
  if [ -f "$of" ]; then
    c_ylw "! already clocked in on $(sed -n 's/.*"project":"\([^"]*\)".*/\1/p' "$of") since $(sed -n 's/.*"start":"\([^"]*\)".*/\1/p' "$of")"
    c_dim "  close it first: ws ${kind/human/clock} out"
    return 1
  fi
  printf '{"kind":"%s","project":"%s","actor":"%s","tool":"%s","start":"%s","start_ts":%s,"note":"%s"}\n' \
    "$kind" "$key" "$(human_id)" "$(agent_id)" "$(now_iso)" "$(now_ts)" "$note" > "$of"
  c_grn "-> $kind clock in on $key"
}

clock_out() {
  local kind="$1"; shift || true
  local note="${*:-}"
  local of; of="$(open_file "$kind")"
  [ -f "$of" ] || die "not clocked in - start with: ws ${kind/human/clock} in <project-key>"

  local key actor tool start start_ts open_note
  key="$(sed -n 's/.*"project":"\([^"]*\)".*/\1/p' "$of")"
  actor="$(sed -n 's/.*"actor":"\([^"]*\)".*/\1/p' "$of")"
  tool="$(sed -n 's/.*"tool":"\([^"]*\)".*/\1/p' "$of")"
  start="$(sed -n 's/.*"start":"\([^"]*\)".*/\1/p' "$of")"
  start_ts="$(sed -n 's/.*"start_ts":\([0-9]*\).*/\1/p' "$of")"
  open_note="$(sed -n 's/.*"note":"\([^"]*\)".*/\1/p' "$of")"
  [ -n "$note" ] || note="$open_note"

  local end end_ts mins
  end="$(now_iso)"; end_ts="$(now_ts)"
  mins=$(( (end_ts - start_ts) / 60 ))

  local f; f="$(works_file "$kind" "$key")"
  mkdir -p "$(dirname "$f")"
  printf '{"kind":"%s","project":"%s","actor":"%s","tool":"%s","start":"%s","end":"%s","start_ts":%s,"end_ts":%s,"minutes":%s,"note":"%s"}\n' \
    "$kind" "$key" "$actor" "$tool" "$start" "$end" "$start_ts" "$end_ts" "$mins" "$note" >> "$f"
  rm -f "$of"
  works_rollup "$(date +%Y-%m)"
  c_grn "-> $kind $((mins / 60))h $((mins % 60))m on $key"
  c_dim "   ${f#$ROOT/}"
}

# Writes a committed summary for one month so a report, a dashboard, or an invoice
# does not have to re-scan every session file. The sessions stay authoritative:
# this file is derived and can be rebuilt at any time with `ws hours --rollup`.
works_rollup() {
  local month="$1"
  [ -d "$WORKS" ] || return 0
  local out="$WORKS/rollup"; mkdir -p "$out"

  local hd ad ht at
  hd="$(hours_net "$WORKS/human" "$month" "-")"
  ad="$(hours_net "$WORKS/agent" "$month" "-")"
  ht="$(printf '%s\n' "$hd" | awk '$1=="TOTAL"{print $2; f=1} END{if(!f)print "0.00"}')"
  at="$(printf '%s\n' "$ad" | awk '$1=="TOTAL"{print $2; f=1} END{if(!f)print "0.00"}')"

  { printf '{\n'
    printf '  "month": "%s",\n' "$month"
    printf '  "generated": "%s",\n' "$(date -u +%FT%TZ)"
    printf '  "note": "Net hours, overlaps merged within each category. human and agent are never summed.",\n'
    printf '  "human_hours": %s,\n' "$ht"
    printf '  "agent_hours": %s,\n' "$at"
    printf '  "by_project": {\n'
    local first=1 key ph pa
    for key in $( { find "$WORKS/human" -maxdepth 1 -mindepth 1 -type d 2>/dev/null; \
                     find "$WORKS/agent"  -maxdepth 1 -mindepth 1 -type d 2>/dev/null; } \
                   | xargs -I{} basename {} 2>/dev/null | sort -u); do
      ph="$(hours_net "$WORKS/human" "$month" "$key" | awk '$1=="TOTAL"{print $2; f=1} END{if(!f)print "0.00"}')"
      pa="$(hours_net "$WORKS/agent" "$month" "$key" | awk '$1=="TOTAL"{print $2; f=1} END{if(!f)print "0.00"}')"
      [ "$ph" = "0.00" ] && [ "$pa" = "0.00" ] && continue
      [ "$first" = 1 ] || printf ',\n'; first=0
      printf '    "%s": {"human_hours": %s, "agent_hours": %s}' "$key" "$ph" "$pa"
    done
    printf '\n  },\n'
    printf '  "by_client": {\n'
    first=1
    local c ckeys ch ca
    if [ -d "$CLIENTS_DIR" ]; then
      for c in "$CLIENTS_DIR"/*/; do
        [ -d "$c" ] || continue
        c="$(basename "$c")"
        ckeys=()
        while IFS= read -r k; do [ -n "$k" ] && ckeys+=("$k"); done < <(client_project_keys "$c")
        [ "${#ckeys[@]}" -gt 0 ] || continue
        ch="$(hours_net "$WORKS/human" "$month" "${ckeys[@]}" | awk '$1=="TOTAL"{print $2; f=1} END{if(!f)print "0.00"}')"
        ca="$(hours_net "$WORKS/agent" "$month" "${ckeys[@]}" | awk '$1=="TOTAL"{print $2; f=1} END{if(!f)print "0.00"}')"
        [ "$ch" = "0.00" ] && [ "$ca" = "0.00" ] && continue
        [ "$first" = 1 ] || printf ',\n'; first=0
        printf '    "%s": {"human_hours": %s, "agent_hours": %s}' "$c" "$ch" "$ca"
      done
    fi
    printf '\n  },\n'
    printf '  "by_day": {\n'
    first=1
    local d dh da
    for d in $(printf '%s\n%s\n' "$hd" "$ad" | awk '$1!="TOTAL" && $1!=""{print $1}' | sort -u); do
      dh="$(printf '%s\n' "$hd" | awk -v k="$d" '$1==k{print $2; f=1} END{if(!f)print "0.00"}')"
      da="$(printf '%s\n' "$ad" | awk -v k="$d" '$1==k{print $2; f=1} END{if(!f)print "0.00"}')"
      [ "$first" = 1 ] || printf ',\n'; first=0
      printf '    "%s": {"human_hours": %s, "agent_hours": %s}' "$d" "$dh" "$da"
    done
    printf '\n  }\n}\n'
  } > "$out/$month.json"
}

clock_status() {
  local kind any=0
  for kind in human agent; do
    local of; of="$(open_file "$kind")"
    if [ -f "$of" ]; then
      any=1
      c_grn "$kind: open on $(sed -n 's/.*"project":"\([^"]*\)".*/\1/p' "$of") since $(sed -n 's/.*"start":"\([^"]*\)".*/\1/p' "$of")"
    fi
  done
  [ "$any" = 1 ] || c_dim "no open session"
  return 0
}

cmd_clock() {
  case "${1:-status}" in
    in)  shift; clock_in human "$@" ;;
    out) shift; clock_out human "$@" ;;
    status) clock_status ;;
    *) die "usage: ws clock [in <project-key> [note] | out [note] | status]" ;;
  esac
}

cmd_agent() {
  case "${1:-status}" in
    in)  shift; clock_in agent "$@" ;;
    out) shift; clock_out agent "$@" ;;
    status) clock_status ;;
    auto) shift; agent_auto "${1:-}" ;;
    *) die "usage: ws agent [in <key> [note] | out [note] | status | auto in|out]" ;;
  esac
}

# Called from an editor hook, where three things are true that are not on a
# command line: nobody reads the output, nobody chose a project, and a non-zero
# exit interrupts someone's session. So this never fails, and when it cannot work
# out which project the work belongs to it records nothing — an hour on the wrong
# project is worse than an hour on none.
agent_auto() {
  local action="${1:-}"
  case "$action" in in|out) ;; *) return 0 ;; esac

  if [ "$action" = out ]; then
    [ -f "$(open_file agent)" ] && clock_out agent "auto" >/dev/null 2>&1
    return 0
  fi

  [ -f "$(open_file agent)" ] && return 0
  mkdir -p "$WORKS" 2>/dev/null || return 0

  # Normalise BOTH sides before comparing. ROOT comes from a logical `pwd` while
  # the session's directory may be physical, and on macOS /tmp and /var are
  # symlinks — so either side alone can disagree with the other.
  local key="" k c f r d here rootp
  here="$(cd "$PWD" 2>/dev/null && pwd -P)" || here="$PWD"
  rootp="$(cd "$ROOT" 2>/dev/null && pwd -P)" || rootp="$ROOT"
  while IFS=$'\t' read -r k c f r d; do
    case "$here/" in "$rootp/$f/"*) key="$k"; break ;; esac
  done < <(reg_rows 2>/dev/null)
  [ -n "$key" ] || key="$(conf_get default_project)"
  [ -n "$key" ] || return 0
  [ -d "$MEM/$key" ] || return 0

  clock_in agent "$key" "auto" >/dev/null 2>&1 || true
  return 0
}

# Net hours per day: overlapping sessions are merged, so two agents running at
# once for an hour is one hour of elapsed work, not two. Human and agent are
# merged independently and never against each other.
hours_net() {
  local dir="$1" month="$2"; shift 2
  local keys=("$@")
  [ -d "$dir" ] || return 0
  local patterns=()
  if [ "${#keys[@]}" -eq 0 ] || { [ "${#keys[@]}" -eq 1 ] && [ "${keys[0]}" = "-" ]; }; then
    patterns=("$dir"/*/"$month.jsonl")
  else
    local k; for k in "${keys[@]}"; do patterns+=("$dir/$k/$month.jsonl"); done
  fi
  # `cat` exits nonzero the moment ANY argument is missing - a non-matching glob
  # left unexpanded, or a project with no session that month, which --client
  # hits routinely (one of a client's projects worked this month, another not).
  # Under pipefail + errexit that kills the whole script from inside a=$(...).
  # Filter to files that actually exist first, so cat never sees a bad path.
  local files=() p
  for p in "${patterns[@]}"; do [ -f "$p" ] && files+=("$p"); done
  [ "${#files[@]}" -eq 0 ] && return 0
  cat "${files[@]}" | awk '
    match($0, /"start_ts":[0-9]+/) { st = substr($0, RSTART+12, RLENGTH-12) }
    match($0, /"end_ts":[0-9]+/)   { en = substr($0, RSTART+10, RLENGTH-10) }
    match($0, /"start":"[^"]+/)    { d  = substr($0, RSTART+9, 10) }
    st && en { key = d; n[key]++; S[key, n[key]] = st; E[key, n[key]] = en; st=en=0 }
    END {
      total = 0
      for (d in n) {
        # insertion sort the day\x27s intervals by start
        for (i = 2; i <= n[d]; i++) {
          s = S[d,i]; e = E[d,i]; j = i - 1
          while (j >= 1 && S[d,j] > s) { S[d,j+1]=S[d,j]; E[d,j+1]=E[d,j]; j-- }
          S[d,j+1]=s; E[d,j+1]=e
        }
        cs = S[d,1]; ce = E[d,1]; day = 0
        for (i = 2; i <= n[d]; i++) {
          if (S[d,i] <= ce) { if (E[d,i] > ce) ce = E[d,i] }
          else { day += ce - cs; cs = S[d,i]; ce = E[d,i] }
        }
        day += ce - cs
        printf "%s %.2f %d\n", d, day/3600, n[d]
        total += day
      }
      printf "TOTAL %.2f 0\n", total/3600
    }' | sort
}

# Newline-separated project keys billed to one client. Empty if the client is
# unknown or has no projects yet - callers then report nothing rather than
# silently falling back to "all projects", which would over-report.
client_project_keys() { reg_rows | awk -F'\t' -v c="$1" '$2==c {print $1}'; }

cmd_hours() {
  local month; month="$(date +%Y-%m)"
  local project="-" client="" rollup=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --month) month="${2:?}"; shift 2 ;;
      --project) project="${2:?}"; shift 2 ;;
      --client) client="${2:?}"; shift 2 ;;
      --rollup) rollup=1; shift ;;
      *) die "usage: ws hours [--month YYYY-MM] [--project <key> | --client <key>] [--rollup]" ;;
    esac
  done
  [ -n "$client" ] && [ "$project" != "-" ] && die "pass --project or --client, not both"
  if [ "$rollup" = 1 ]; then
    works_rollup "$month"
    c_grn "-> ${WORKS#$ROOT/}/rollup/$month.json"
    return 0
  fi
  [ -d "$WORKS" ] || die "no hours recorded yet (context/works/)"

  local keys=() scope="all projects"
  if [ -n "$client" ]; then
    while IFS= read -r k; do [ -n "$k" ] && keys+=("$k"); done < <(client_project_keys "$client")
    [ "${#keys[@]}" -gt 0 ] || die "no project in registry.tsv has client '$client'"
    scope="client $client (${keys[*]})"
  elif [ "$project" != "-" ]; then
    keys=("$project"); scope="$project"
  else
    keys=("-")
  fi
  echo "Hours for $month - $scope"
  echo

  local h a
  h="$(hours_net "$WORKS/human" "$month" "${keys[@]}")"
  a="$(hours_net "$WORKS/agent" "$month" "${keys[@]}")"

  printf '%-12s %10s %10s\n' DAY HUMAN AGENT
  local d
  for d in $(printf '%s\n%s\n' "$h" "$a" | awk '$1!="TOTAL"{print $1}' | sort -u); do
    printf '%-12s %10s %10s\n' "$d" \
      "$(printf '%s\n' "$h" | awk -v k="$d" '$1==k{print $2; f=1} END{if(!f)print "-"}')" \
      "$(printf '%s\n' "$a" | awk -v k="$d" '$1==k{print $2; f=1} END{if(!f)print "-"}')"
  done
  echo
  printf '%-12s %10s %10s\n' TOTAL \
    "$(printf '%s\n' "$h" | awk '$1=="TOTAL"{print $2; f=1} END{if(!f)print "0.00"}')" \
    "$(printf '%s\n' "$a" | awk '$1=="TOTAL"{print $2; f=1} END{if(!f)print "0.00"}')"
  echo
  c_dim "Net hours: overlapping sessions merged within each column."
  c_dim "The two columns are deliberately not summed - see 'Two clocks' in AGENTS.md."
}

# ─────────────────────────────────────────────────────────────── doctor
cmd_doctor() {
  local fail=0 ci=0
  [ "${1:-}" = "--ci" ] && ci=1
  echo "Workspace: $ROOT"; echo

  if [ "$ci" = 0 ]; then
    echo "-- Toolchain --"
    if command -v java >/dev/null; then
      local jv; jv="$(java -version 2>&1 | head -1 | sed -E 's/.*"([0-9]+).*/\1/')"
      [ "${jv:-0}" -ge 21 ] && c_grn "ok Java $jv" || { c_red "x Java $jv - requires 21+"; fail=1; }
    else c_red "x java not found"; fail=1; fi
    command -v git >/dev/null && c_grn "ok git $(git --version | awk '{print $3}')" || { c_red "x git"; fail=1; }
    command -v docker >/dev/null && c_grn "ok docker" || c_ylw "! docker missing - Testcontainers will not run"
    c_dim "  (maven not required: use ./mvnw inside each product repo)"
    echo
  fi

  echo "-- Identity --"
  if [ -f "$CONF" ]; then
    c_grn "ok workspace.conf: $ORG_NAME ($ORG_KEY)"
  else
    c_red "x no workspace.conf - this clone belongs to nobody yet; run: ws init"; fail=1
  fi
  if [ -d "$CONTEXT_DIR/.git" ]; then
    c_grn "ok context repo at ${CONTEXT_DIR#$ROOT/}"
    local ctxremote; ctxremote="$(git -C "$CONTEXT_DIR" remote get-url origin 2>/dev/null || true)"
    if [ -z "$ctxremote" ]; then
      c_ylw "  ! context has no remote - this organisation's memory is on one machine"
    elif [ "$ci" = 0 ] && repo_is_public "$ctxremote"; then
      # The context repo holds client names, contract scope, domain glossaries and
      # hours. Published, that is a disclosure, not an untidy repository.
      c_red "  x CONTEXT REPO IS PUBLIC - it can be read without credentials"
      c_dim "      $ctxremote"
      c_dim "      set it to Private in the host's settings, then assume what it held is disclosed"
      fail=1
    else
      c_dim "  remote: $ctxremote (not readable anonymously)"
    fi
  else
    c_ylw "! no context repo - run: ws context init (or: ws context clone <remote>)"
  fi
  echo

  echo "-- Repo isolation --"
  local leaked; leaked="$(git -C "$ROOT" ls-files projects/ 2>/dev/null | grep -v '^projects/\(README.md\|registry.tsv\)$' || true)"
  if [ -n "$leaked" ]; then
    c_red "x product repo files leaked into the workspace index:"; printf '%s\n' "$leaked" | sed 's/^/    /'; fail=1
  else c_grn "ok no product repo is tracked in this workspace"; fi

  # Probe a path INSIDE the directory: a trailing-slash pattern only matches a
  # directory that exists, and in a fresh clone neither of these does yet.
  git -C "$ROOT" check-ignore -q .local/probe \
    && c_grn "ok .local/ is ignored" || { c_red "x .local/ is NOT ignored"; fail=1; }

  # The framework is shared across organisations; no one organisation's context or code
  # may be tracked in it.
  if git -C "$ROOT" check-ignore -q context/probe; then
    c_grn "ok context/ is ignored by the framework"
  else
    c_red "x context/ is NOT ignored - one organisation's memory would enter the shared repo"; fail=1
  fi
  local ctxleak; ctxleak="$(git -C "$ROOT" ls-files context/ 2>/dev/null || true)"
  if [ -n "$ctxleak" ]; then
    c_red "x context files tracked in the framework repo:"; printf '%s\n' "$ctxleak" | sed 's/^/    /'; fail=1
  fi

  # This workspace only reaches the team through a remote. Without one, standards,
  # skills, and memory exist on exactly one laptop.
  if [ -n "$(git -C "$ROOT" remote 2>/dev/null)" ]; then
    c_grn "ok workspace has a remote ($(git -C "$ROOT" remote get-url origin 2>/dev/null || git -C "$ROOT" remote | head -1))"
  else
    c_red "x workspace has no git remote - nothing here is shared with the team yet"
    c_dim "    git remote add origin <url> && git push -u origin main"
    fail=1
  fi

  # Tracked files must not carry one machine's paths: they are read on every machine.
  local absp; absp="$(git -C "$ROOT" grep -nIE '(/Users/|/home/)[A-Za-z0-9._-]+' -- . 2>/dev/null || true)"
  if [ -n "$absp" ]; then
    c_red "x machine-specific absolute paths in tracked files:"; printf '%s\n' "$absp" | sed 's/^/    /'
    c_dim "    use workspace-relative paths, or ~ in prose"
    fail=1
  else c_grn "ok no machine-specific absolute paths are tracked"; fi

  # workspace.conf is the only place an organisation may be named. Everything else is
  # shared, so a company or client name in a tracked file is a portability defect.
  if [ -f "$CONF" ] && [ "$ORG_KEY" != "org" ]; then
    local named; named="$(git -C "$ROOT" grep -lieE "$ORG_KEY" -- . ':(exclude)workspace.conf' 2>/dev/null || true)"
    if [ -n "$named" ]; then
      c_ylw "! the organisation key '$ORG_KEY' appears in tracked framework files:"
      printf '%s\n' "$named" | sed 's/^/    /'
      c_dim "    only workspace.conf should name an organisation"
    else
      c_grn "ok the framework names no organisation but in workspace.conf"
    fi
  fi

  # /projects/* hides product code from every gitignore-aware search tool
  # (ripgrep, VS Code, agent Grep). .ignore restores search without touching git.
  if [ -f "$ROOT/.ignore" ] && grep -qxF '!projects/*/' "$ROOT/.ignore"; then
    c_grn "ok .ignore keeps product code searchable from the root"
  else
    c_ylw "! .ignore missing - searches from the root will not see product code"
    c_dim "    echo '!projects/*/' >> .ignore"
  fi
  echo

  echo "-- Projects --"
  local dup
  dup="$(reg_rows | cut -f1 | sort | uniq -d)"
  if [ -n "$dup" ]; then
    c_red "x duplicate keys in registry.tsv: $(printf '%s' "$dup" | tr '\n' ' ')"; fail=1
  fi
  dup="$(reg_rows | cut -f3 | sort | uniq -d)"
  if [ -n "$dup" ]; then
    c_red "x duplicate folders in registry.tsv: $(printf '%s' "$dup" | tr '\n' ' ')"; fail=1
  fi
  local key client folder remote desc
  while IFS=$'\t' read -r key client folder remote desc; do
    local dst="$ROOT/$folder"
    if is_empty "$remote"; then
      c_ylw "! $key has no remote in registry.tsv - teammates cannot clone it"
      c_dim "    add it as the remote column of context/registry.tsv"
    fi
    if is_empty "$client"; then
      c_ylw "! $key has no client in registry.tsv - ws hours --client and domain-skill lookup won't find it"
    elif [ ! -d "$CLIENTS_DIR/$client" ]; then
      c_red "x $key declares client '$client', but context/clients/$client/ does not exist"; fail=1
    fi
    if [ ! -d "$dst" ]; then c_ylw "! $key not cloned yet (ws bootstrap)"; continue; fi
    if [ ! -d "$dst/.git" ]; then c_red "x $key exists but is not a git repo"; fail=1; continue; fi
    c_grn "ok $key is a separate repo"

    [ -n "$(git -C "$dst" remote 2>/dev/null)" ] \
      || c_ylw "  ! no remote configured - local commits exist nowhere else"

    if [ ! -f "$dst/AGENTS.md" ] || [ ! -f "$dst/.workspace" ]; then
      c_ylw "  ! pointer missing - run: ws link $key"
    else
      # The pointer embeds absolute paths. If the workspace was moved or renamed,
      # or the repo was cloned on another machine, those paths are now wrong.
      local marked; marked="$(sed -n 's/^workspace=//p' "$dst/.workspace" | head -1)"
      if [ "$marked" != "$ROOT" ]; then
        c_ylw "  ! pointer is stale (says $marked) - run: ws link $key"
      fi
    fi

    # Both pointers must be excluded, and neither may ever be tracked.
    local exc="$dst/.git/info/exclude" pat
    for pat in '/AGENTS.md' '/.workspace'; do
      grep -qxF "$pat" "$exc" 2>/dev/null \
        || c_ylw "  ! $pat not in .git/info/exclude - run: ws link $key"
    done
    for pat in 'AGENTS.md' '.workspace'; do
      if git -C "$dst" ls-files --error-unmatch "$pat" >/dev/null 2>&1; then
        c_red "  x $pat is TRACKED in the client repo - it must stay untracked"
        c_dim "      git -C $folder rm --cached $pat"
        fail=1
      fi
    done
    if [ -f "$dst/.git/hooks/pre-commit" ] && grep -q 'ws-guard' "$dst/.git/hooks/pre-commit"; then
      c_grn "  ok pre-commit guard installed"
    else
      c_ylw "  ! pre-commit guard missing - run: ws link $key"
    fi

    [ -d "$MEM/$key" ] || c_ylw "  ! no memory at .agents/memory/projects/$key/"
  done < <(reg_rows)
  echo

  echo "-- Standards --"
  local pack packs_ok=1
  for pack in $(conf_get packs core | tr ',' ' '); do
    pack="$(printf '%s' "$pack" | tr -d '[:space:]')"
    [ -n "$pack" ] || continue
    if [ -d "$ROOT/.agents/standards/$pack" ]; then
      c_grn "ok pack '$pack' ($(count_files "$ROOT/.agents/standards/$pack" -name '*.md') standards)"
    else
      c_red "x workspace.conf declares pack '$pack', but .agents/standards/$pack/ does not exist"
      fail=1; packs_ok=0
    fi
  done
  # core carries git workflow, the API contract and the definition of done. The
  # concrete testing, security and observability rules live in the stack packs,
  # so a workspace running core alone has no binding rules for them and should
  # know it rather than assume the Java ones transfer.
  if [ "$packs_ok" = 1 ] && [ "$(conf_get packs core | tr -d '[:space:]')" = "core" ]; then
    c_ylw "! only 'core' is enabled - no binding testing, security or observability rules"
    c_dim "    add a stack pack, or write one: .agents/standards/README.md"
  fi
  echo

  echo "-- Skills --"
  if [ ! -f "$MANIFEST" ]; then
    c_ylw "! no .agents/skills.manifest - this workspace pulls no skills"
  else
    local want have
    want="$(manifest_resolve 2>/dev/null | sort -u | wc -l | tr -d ' ')"
    have="$(count_files "$SKILLS" -maxdepth 2 -name SKILL.md)"
    if [ ! -f "$LOCK" ]; then
      c_ylw "! never synced - run: ws skills sync"
    elif [ "$want" != "$have" ] || [ "$have" = 0 ]; then
      c_ylw "! skills out of sync ($want wanted, $have present) - run: ws skills sync"
    else
      c_grn "ok $have skills at $(sed -n 's/^commit[[:space:]]*=[[:space:]]*//p' "$LOCK" | cut -c1-8)"
    fi
    # Fetched skills are generated output. If they are tracked here, the source
    # repository has quietly stopped being the single source.
    if [ -n "$(git -C "$ROOT" ls-files .agents/skills 2>/dev/null)" ]; then
      c_red "x .agents/skills/ is tracked - it is generated by 'ws skills sync'"; fail=1
    fi
  fi
  local nctx=0
  nctx="$(count_files "$CONTEXT_SKILLS" -maxdepth 2 -name SKILL.md)"
  [ "$nctx" != 0 ] && c_grn "ok $nctx domain skill(s) in context/skills/"
  echo

  echo "-- Hours --"
  if [ -d "$WORKS" ]; then
    local hm am
    hm="$(count_files "$WORKS/human" -name '*.jsonl')"
    am="$(count_files "$WORKS/agent" -name '*.jsonl')"
    c_grn "ok human and agent hours recorded separately ($hm / $am month files)"
    local open; open="$(count_files "$WORKS" -maxdepth 1 -name '.open-*.json')"
    [ "$open" = 0 ] || c_ylw "  ! $open session still clocked in - close it with: ws clock out"
  else
    c_dim "- no hours recorded yet (ws clock in <project-key>)"
  fi
  echo

  [ "$fail" = 0 ] && c_grn "doctor: healthy" || { c_red "doctor: problems reported above"; exit 1; }
}

# ─────────────────────────────────────────────────────────────── hooks
# Editor hooks run commands by themselves, so they are opt-in: the repository
# ships an example and this installs it, rather than every clone silently gaining
# a command that fires on every session.
cmd_hooks() {
  local src="$ROOT/.claude/settings.json.example" dst="$ROOT/.claude/settings.json"
  case "${1:-status}" in
    status)
      if [ -f "$dst" ] && grep -q 'ws agent auto' "$dst" 2>/dev/null; then
        c_grn "agent clock hooks: installed"
      else
        c_dim "agent clock hooks: not installed - run: ws hooks install"
      fi ;;
    install)
      [ -f "$src" ] || die "no .claude/settings.json.example in this workspace"
      if [ -f "$dst" ] && ! grep -q 'ws agent auto' "$dst" 2>/dev/null; then
        c_ylw "! .claude/settings.json exists and is not ours - left untouched"
        c_dim "  merge the hooks by hand from: ${src#$ROOT/}"
        return 0
      fi
      mkdir -p "$(dirname "$dst")"; cp "$src" "$dst"
      c_grn "-> agent clock hooks installed"
      c_dim "   Claude Code now clocks agent time in and out by itself" ;;
    remove)
      if [ -f "$dst" ] && grep -q 'ws agent auto' "$dst" 2>/dev/null; then
        rm -f "$dst"; c_grn "-> agent clock hooks removed"
      else c_dim "- nothing of ours to remove"; fi ;;
    *) die "usage: ws hooks [status|install|remove]" ;;
  esac
}

# ─────────────────────────────────────────────────────────────── ide
# .vscode/settings.json is git-ignored so nobody's local tweaks are shared. The
# team defaults therefore have to be copied in once per clone.
cmd_ide() {
  local src="$ROOT/.vscode/settings.shared.json" dst="$ROOT/.vscode/settings.json"
  [ -f "$src" ] || die "no .vscode/settings.shared.json in this workspace"
  if [ -f "$dst" ]; then
    if diff -q "$src" "$dst" >/dev/null; then c_dim "- settings.json already matches the shared defaults"
    else
      c_ylw "! .vscode/settings.json exists and differs - left untouched"
      c_dim "  compare with: diff .vscode/settings.shared.json .vscode/settings.json"
    fi
    return 0
  fi
  cp "$src" "$dst"
  c_grn "-> .vscode/settings.json written from the shared defaults"
}

cmd_help() {
  cat <<'H'
ws — engineering workspace CLI

  ws init [--org N --key k --group g]   re-brand a fresh clone for an organisation
  ws context [status|init|clone <r>]    the organisation's private memory repo
  ws client [new <key>|list]        a client that may span several projects
  ws list                          list projects and clone status
  ws bootstrap                     clone every product repo from registry.tsv
  ws new <key> <folder> [remote] [--client c]   register a new project + memory
  ws link <key>                    write the untracked AGENTS.md pointer in a product repo
  ws unlink <key>                  remove the pointer
  ws run <key> "title"             create a new run under .agents/runs/<key>/
  ws log <key> "milestone"         append one row to the project log
  ws sync                          pull the workspace, report product repo state
  ws route "task description"      show which skills apply
  ws skills [status|sync|add <n>|remove <n>|available|index]
                                    skills pulled from the skills repository
  ws clock in|out|status            HUMAN working hours
  ws agent in|out|status            AGENT working hours - never summed with human
  ws hours [--month M] [--project k|--client c] [--rollup]   report both, side by side
  ws ide                           copy the shared VS Code defaults into this clone
  ws hooks [status|install|remove]  clock agent time automatically in Claude Code
  ws where                         print the workspace root from anywhere
  ws doctor [--ci]                 check repo isolation, ignores, toolchain
  ws help                          this help

Add to PATH (run once, from inside your clone):
  echo "export PATH=\"$PWD/.agents/bin:\$PATH\"" >> ~/.zshrc && source ~/.zshrc
H
}

case "${1:-help}" in
  init) shift; cmd_init "$@" ;;
  context) shift; cmd_context "$@" ;;
  client) shift; cmd_client "$@" ;;
  list) shift; cmd_list "$@" ;;
  bootstrap) shift; cmd_bootstrap "$@" ;;
  new) shift; cmd_new "$@" ;;
  link) shift; cmd_link "$@" ;;
  where) shift; cmd_where "$@" ;;
  unlink) shift; cmd_unlink "$@" ;;
  run) shift; cmd_run "$@" ;;
  clock) shift; cmd_clock "$@" ;;
  agent) shift; cmd_agent "$@" ;;
  hours) shift; cmd_hours "$@" ;;
  log) shift; cmd_log "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  route) shift; cmd_route "$@" ;;
  skills) shift; cmd_skills "$@" ;;
  ide) shift; cmd_ide "$@" ;;
  hooks) shift; cmd_hooks "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $1 (try: ws help)" ;;
esac
